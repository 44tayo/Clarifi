# Clarifi cloud API (recommended — users pay via your backend, not BYOK)
# Local: http://localhost:3000
# Production packaged builds bake https://www.clarifiapp.com via .env.production
CLARIFI_API_URL=http://localhost:3000
# Connect: desktop Sign up/Login opens web OAuth → clarifi:// auth deep link

# Legacy BYOK fallback (only used when CLARIFI_API_URL + token are not set)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# EU data residency (optional, both default to the global/US endpoint):
# - Deepgram's EU endpoint is self-serve, just set the URL below.
# - Groq's EU endpoint (Helsinki) must be enabled by Groq sales first, or
#   requests will fail with 403.
# GROQ_API_BASE_URL=https://api.eu.groq.com
# DEEPGRAM_API_BASE_URL=https://api.eu.deepgram.com

# Packaged app: ~/Library/Application Support/Clarifi/.env with CLARIFI_API_URL + token

# Signed Mac DMG (Gatekeeper): copy .env.signing.example → .env.signing.local, then:
#   ./scripts/setup-mac-signing.sh

# Auto-update GitHub repo (set when publishing releases)
GH_UPDATE_OWNER=your-github-org
GH_UPDATE_REPO=clarifi-desktop
