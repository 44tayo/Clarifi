# Supabase — required for auth and database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe webhook is handled by Supabase Edge Function (not Next.js):
# https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# Edge function secrets (Supabase dashboard — names cannot start with SUPABASE_):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_PRO, STRIPE_PRICE_PRO_ANNUAL,
#   STRIPE_PRICE_PRO_PLUS, STRIPE_PRICE_PRO_PLUS_ANNUAL, SERVICE_ROLE_KEY
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_PLUS=
STRIPE_PRICE_PRO_PLUS_ANNUAL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO_ANNUAL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO_PLUS=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO_PLUS_ANNUAL=

# Server-side LLM keys (never exposed to desktop clients)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# EU data residency for transcription (optional, defaults to the global/US
# endpoint). Groq's EU endpoint (Helsinki) must be enabled by Groq sales
# first, or requests will fail with 403.
# GROQ_API_BASE_URL=https://api.eu.groq.com

# Pepper for hashing desktop device secrets (server-only)
DEVICE_AUTH_PEPPER=

# Supabase user IDs that bypass rate limits and get Pro+ (comma-separated)
CREATOR_USER_IDS=

# Emails granted lifetime Pro+ on signup/login (comma-separated, case-insensitive)
CREATOR_EMAILS=

NEXT_PUBLIC_CLARIFI_MAC_DOWNLOAD_URL=
NEXT_PUBLIC_CLARIFI_WIN_DOWNLOAD_URL=
NEXT_PUBLIC_APP_URL=https://www.clarifiapp.com

# Calendar integration (Google Calendar + Microsoft Outlook)
# Use the same OAuth apps as sign-in, or dedicated calendar apps.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Invite emails (Resend). Without these, invite URLs are logged server-side only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clarifi <invites@clarifiapp.com>

# Legacy alias — use NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
